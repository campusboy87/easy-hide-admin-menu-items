#. Description of the plugin/theme
msgid "The plugin allows hiding selected admin menu items."
msgstr "Плагин позволяет скрывать выбранные пункты меню администратора."

#. Plugin URI of the plugin/theme
msgid "https://github.com/campusboy87/easy-hide-admin-menu-items"
msgstr "https://github.com/campusboy87/easy-hide-admin-menu-items"

#. Plugin Name of the plugin/theme
msgid "Easy Hide Admin Menu Items"
msgstr "Easy Hide Admin Menu Items"

#: src/Assets.php:38
msgid "Settings saved."
msgstr "Настройки сохранены."

#: src/Assets.php:39
msgid "Error saving settings."
msgstr "Не удалось сохранить настройки."

#: templates/admin-page-options.php:35
msgid "No changes (default)"
msgstr "Без изменений (по умолчанию)"

#: templates/admin-page-options.php:36
msgid "Hide all separators"
msgstr "Скрыть все разделители"

#: templates/admin-page-options.php:37
msgid "Highlight separators"
msgstr "Выделить разделители"

#: templates/admin-page-options.php:102 templates/admin-page-options.php:108
msgid "Menu Sorting"
msgstr "Сортировка меню"

#: templates/admin-page-options.php:119
msgid "Enable drag-and-drop menu reordering"
msgstr "Разрешить изменение порядка пунктов меню перетаскиванием"

#: templates/admin-page-options.php:128
msgid "Drag the handle icon on the right side of menu items to reorder them."
msgstr ""
"Чтобы изменить порядок пунктов меню, перетащите значок справа от пункта."

#: templates/admin-page-options.php:131
msgid "Note:"
msgstr "Примечание:"

#: templates/admin-page-options.php:132
msgid ""
"your custom order is preserved even when this option is disabled. Use "
"\"Reset menu order\" to restore the default order."
msgstr ""
"заданный порядок сохраняется даже при отключении этой настройки. Чтобы "
"восстановить порядок по умолчанию, нажмите «Сбросить порядок меню»."

#: templates/admin-page-options.php:135 templates/admin-page-options.php:179
#: templates/admin-page-options.php:224
msgid "Experimental"
msgstr "Экспериментальная функция"

#: templates/admin-page-options.php:138
msgid "Reset menu order"
msgstr "Сбросить порядок меню"

#: templates/admin-page-options.php:150 templates/admin-page-options.php:156
msgid "Sidebar Width"
msgstr "Ширина боковой панели"

#: templates/admin-page-options.php:167
msgid "Enable sidebar width resize"
msgstr "Разрешить изменение ширины боковой панели"

#: templates/admin-page-options.php:176
msgid "Drag the right edge of the sidebar to adjust the menu width."
msgstr "Чтобы изменить ширину меню, перетащите правый край боковой панели."

#: templates/admin-page-options.php:182
msgid "Reset sidebar width"
msgstr "Сбросить ширину боковой панели"

#: templates/admin-page-options.php:194 templates/admin-page-options.php:200
msgid "Menu Separators"
msgstr "Разделители меню"

#: templates/admin-page-options.php:221
msgid ""
"Control the visibility of separator lines between menu groups in the admin "
"sidebar."
msgstr ""
"Управляйте отображением линий между группами пунктов меню в боковой панели "
"администратора."
